# Optional. Without this key, hosted OpenAI voices are unavailable.
# OPENAI_API_KEY=

# OpenAI speech model. tts-1-hd is the quality-oriented stock model.
# Emotional "direction" / instructions are out of scope for this workbench.
# OPENAI_TTS_MODEL=tts-1-hd

# Where mp3s and sidecar .txt files are written.
# TTS_LIBRARY_DIR=~/TTS

# Kokoro / Piper model cache (Hugging Face weights, Piper .onnx files).
# TTS_CACHE_DIR=~/.cache/tts-workbench

# Piper binary. Auto-detected if unset (piper, piper-tts, python3 -m piper).
# PIPER_BIN=piper
# PIPER_MODELS_DIR=~/.cache/tts-workbench/piper

# Local web UI. Bound to 127.0.0.1 only.
# PORT=3333

# ffmpeg binary. Auto-detected if unset (PATH, then ffmpeg-static).
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Kokoro precision. q8 is the CPU default.
# KOKORO_DTYPE=q8
# KOKORO_DEVICE=cpu
